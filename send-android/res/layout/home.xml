<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. Two things and no more: what your PC is doing, and a box to send a
  link from. Pairing lives on its own screen, because it happens once and then
  never again - putting it here would make a setup step the first thing you
  see every single time.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <!-- fitsSystemWindows above, because Android 15 draws apps edge to edge:
         without it the app icon sits underneath the clock. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/ink_faint"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!--
          An update, when there is one. Above the status card because it is
          the only thing on this screen that asks to be acted on; the rest of
          the time it is not here at all.
        -->
        <LinearLayout
            android:id="@+id/updateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_title"
                android:textColor="@color/cyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink_dim"
                android:textSize="12.5sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/update"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="@string/update_now"
                android:textColor="@color/cyan_deep"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- what the PC is doing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/checking"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="20dp"
                android:textColor="@color/ink_dim"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/check"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:text="@string/check"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_ghost"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- send a link from here -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card"
            android:padding="18dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send_a_link"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/send_a_link_why"
                android:textColor="@color/ink_faint"
                android:textSize="12.5sp"
                android:lineSpacingExtra="2dp" />

            <EditText
                android:id="@+id/link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/link_hint"
                android:textColor="@color/ink"
                android:textColorHint="@color/idle"
                android:textSize="14sp"
                android:gravity="top|start"
                android:minLines="4"
                android:maxLines="10"
                android:scrollbars="vertical"
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="14dp"
                android:background="@drawable/field"
                android:imeOptions="actionSend" />

            <Button
                android:id="@+id/send"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/send_now"
                android:textColor="@color/cyan_deep"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- the way it is meant to be used -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/or_share"
            android:textColor="@color/ink_dim"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/pairing"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/pairing_screen"
            android:textColor="@color/ink"
            android:textSize="13.5sp"
            android:textAllCaps="false"
            android:background="@drawable/btn_ghost"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/privacy"
            android:textColor="@color/ink_faint"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <!-- Worth one line: the first thing anyone is asked when something is
             wrong is which version they are on. -->
        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/idle"
            android:textSize="11.5sp" />
    </LinearLayout>
</ScrollView>
