<?xml version="1.0" encoding="utf-8"?>
<!-- Unpairing. Muted rather than loud: it is a real action, not an alarm. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A1723" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#4A1E2C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_wash" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#3A1723" />
        </shape>
    </item>
</selector>
