<?xml version="1.0" encoding="utf-8"?>
<!-- The one action a screen is for. Disabled state included, because a button
     that looks identical while it is busy is how people tap twice. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1B3B41" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#17C3D6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/cyan" android:endColor="#17C3D6"
                android:angle="315" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
