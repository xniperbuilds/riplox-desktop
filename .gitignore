# Shipped binaries - fetched with build\fetch_binaries.py, ~180 MB
bin/

# Build output. PyInstaller writes its working files under build\<specname>\;
# they are rebuilt every time, weigh ~24 MB, and the .toc/xref files record the
# absolute paths of the machine that built them.
dist/
dist_installer/
build/work/
build/_work/
build/riplox/
*.spec.bak

# The same, for the companion senders that live beside it.
send-windows/dist/
send-windows/dist_installer/
send-windows/build/riploxsend/
send-android/dist/
send-android/build/_work/
send-android/build/gen/

# The phone app, base64 for the relay to serve. A build output that changes
# with every Android build, and this repository has already had to have its
# history rewritten once to get binaries back out of it. Rebuild it with
# SendToRiplox\build\pack_for_relay.py before deploying the relay.
relay/apk.js

# Working notes. They name people and machines, and this repository is public.
V1.2_PLAN.md
YOUTUBE_FIX_PLAN.md
FINAL_PLAN.md

# Working scripts: one-off probes, diagnostics, and the tests that still carry
# this machine's own paths or real links out of somebody's history. Those need
# a pass for personal data before they could be published, and until then this
# line is the only thing keeping them out.
#
# The clean ones now live in tests/ and are part of the repository. See
# tests/README.md, which says what is still held back here and why - a test
# nobody else can run is a test that exists on one laptop.
tests-local/

# Local state from `wrangler dev`, which is a machine's own scratch copy of
# the Durable Object storage.
relay/.wrangler/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
