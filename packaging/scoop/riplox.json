{
    "version": "1.3.0",
    "description": "A free video downloader for Windows. Paste a link, pick a quality, keep the file.",
    "homepage": "https://xniperbuilds.com/riplox-desktop/",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/xniperbuilds/riplox-desktop/releases/download/v1.3.0/Riplox_Portable_v1.3.0.zip",
            "hash": ""
        }
    },
    "shortcuts": [
        [
            "Riplox.exe",
            "Riplox"
        ]
    ],
    "persist": [
        "Data"
    ],
    "checkver": {
        "github": "https://github.com/xniperbuilds/riplox-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xniperbuilds/riplox-desktop/releases/download/v$version/Riplox_Portable_v$version.zip"
            }
        }
    },
    "extract_dir": "Riplox",
    "pre_install": [
        "if (!(Test-Path \"$dir\\Data\")) { New-Item -ItemType Directory \"$dir\\Data\" | Out-Null }"
    ]
}
